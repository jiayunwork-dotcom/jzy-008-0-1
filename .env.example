# 复制为 .env 或直接 export。全部变量均有缺省值。

# 监听端口/地址
PORT=3000
HOST=0.0.0.0

# 存储模式：pg = 外部 Postgres；pglite = 嵌入式落盘（默认，无需任何依赖）
KIN_STORAGE=pglite

# KIN_STORAGE=pg 时：完整连接串（给出后优先生效）
# DATABASE_URL=postgres://kinematics:kinematics@localhost:5432/kinematics
# 或分项：
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=kinematics
# PGUSER=kinematics
# PGPASSWORD=kinematics

# KIN_STORAGE=pglite 时的数据目录
KIN_DATA_DIR=./data/pglite
